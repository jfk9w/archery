# Maintainer: Igor Kulkov <arch.i@sonc.top>

pkgname=nvidia-open-lts
epoch=1
_nvidia_version=610.57.04
_kernel_pkgver=6.18.44-1
_kernel_release=6.18.44-1-lts
pkgver="${_nvidia_version}.${_kernel_pkgver//-/.}"
pkgrel=1
pkgdesc='NVIDIA open kernel modules prebuilt for linux-lts'
arch=('x86_64')
url='https://github.com/NVIDIA/open-gpu-kernel-modules'
license=('MIT AND GPL-2.0-only')
depends=(
  "linux-lts=${_kernel_pkgver}"
  "nvidia-utils=${_nvidia_version}"
  'libglvnd'
)
makedepends=(
  "linux-lts-headers=${_kernel_pkgver}"
  "nvidia-open-dkms=${_nvidia_version}"
)
options=('!strip' '!debug')
conflicts=('nvidia-lts')
replaces=('nvidia-lts<=1:580.119.02-3')
provides=('NVIDIA-MODULE')

build() {
  fakeroot dkms build --dkmstree "${srcdir}" \
    -m "nvidia/${_nvidia_version}" -k "${_kernel_release}"
}

package() {
  local dkms_tree="nvidia/${_nvidia_version}/${_kernel_release}"
  local destination="${pkgdir}/usr/lib/modules/${_kernel_release}/extramodules"
  local name module

  for name in nvidia nvidia-drm nvidia-modeset nvidia-peermem nvidia-uvm; do
    module=$(find "${dkms_tree}" -type f -path "*/module/${name}.ko" -print -quit)
    if [[ -z ${module} ]]; then
      printf 'DKMS did not produce %s.ko below %s\n' "${name}" "${dkms_tree}" >&2
      return 1
    fi
    install -Dm644 "${module}" "${destination}/${name}.ko"
  done

  find "${pkgdir}" -name '*.ko' -exec zstd --rm -19 {} +

  install -Dm644 /usr/share/licenses/nvidia-open-dkms/LICENSE \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
