# Maintainer: Igor Kulkov <arch.i@sonc.top>

pkgname=caddy
_caddy_version=2.11.4
_build_timestamp=20260818193906
_caddy_checksum=2c3d02078286a6282cdb4d1d8744077788d556659dac0b64d8ed5886a7e5aeb9
_dist_checksum=be6a69751f8b16f1b0f05016fc12bd6ff374c3451941d109823ff87e115bcdf1
pkgver="${_caddy_version}.${_build_timestamp}"
pkgrel=1
pkgdesc='Fast and extensible HTTP server with custom DNS and layer4 modules'
arch=('x86_64')
url='https://caddyserver.com/'
license=('Apache-2.0')
depends=('mailcap')
makedepends=('git' 'go')
backup=('etc/caddy/Caddyfile')
source=(
  "caddy-${_caddy_version}.tar.gz::https://github.com/caddyserver/caddy/archive/refs/tags/v${_caddy_version}.tar.gz"
  "caddy-dist-${_caddy_version}.tar.gz::https://github.com/caddyserver/dist/archive/refs/tags/v${_caddy_version}.tar.gz"
  'caddy.service'
  'caddy-api.service'
  'caddy.sysusers'
  'caddy.tmpfiles'
  'Caddyfile'
)
sha256sums=(
  "${_caddy_checksum}"
  "${_dist_checksum}"
  '6509e1fce2aae0c5225ed1212c9c65d335c799add21db91cfdfc41c845d00848'
  '6ff90a8e30217b93513ae990706a6625fb0f0ecc09cf3f1aca44f4da4e2e8e2b'
  '02b16b9523f85c37292ac1f54ccb6038c414a2693ae3fb7031d7de5fbee97a55'
  '654720ba129d7506676df0923737df513c2a438e6141dafbac66c61e4c1c04a0'
  '7f7de880d014938d78dcb7bb5848dcc12f047de47bf4bc503323ff5774f40164'
)

prepare() {
  sed 's|/var/www/html|/srv/http|g' -i \
    "dist-${_caddy_version}/welcome/index.html"
}

build() {
  export CGO_ENABLED=0
  export GOBIN="${srcdir}/bin"
  export GOFLAGS='-buildvcs=false -trimpath'

  go install github.com/caddyserver/xcaddy/cmd/xcaddy@v0.4.5
  "${GOBIN}/xcaddy" build "v${_caddy_version}" \
    --with github.com/caddy-dns/porkbun@v0.3.1 \
    --with github.com/jfk9w-go/caddy-dns-selectel@fab446026ca90f042ac7e8c9c17105883faf1b2e \
    --with github.com/mholt/caddy-l4@v0.1.2 \
    --with github.com/caddyserver/replace-response@80962887e4c6 \
    --output "${srcdir}/caddy"

  for shell in bash fish zsh; do
    "${srcdir}/caddy" completion "$shell" >"${srcdir}/caddy.${shell}"
  done
}

check() {
  local version
  version=$("${srcdir}/caddy" version)
  printf 'Caddy version: %s\n' "$version"
  [[ $version == "v${_caddy_version}" || $version == "v${_caddy_version} "* ]]

  "${srcdir}/caddy" list-modules --packages | awk '{ print $NF }' | grep -Fx github.com/caddy-dns/porkbun
  "${srcdir}/caddy" list-modules --packages | awk '{ print $NF }' | grep -Fx github.com/jfk9w-go/caddy-dns-selectel
  "${srcdir}/caddy" list-modules --packages | awk '{ print $NF }' | grep -Fx github.com/mholt/caddy-l4
  "${srcdir}/caddy" list-modules --packages | awk '{ print $NF }' | grep -Fx github.com/caddyserver/replace-response
}

package() {
  install -Dm644 "dist-${_caddy_version}/welcome/index.html" \
    "${pkgdir}/usr/share/caddy/index.html"
  install -Dm644 caddy.service caddy-api.service \
    -t "${pkgdir}/usr/lib/systemd/system"
  install -Dm644 caddy.tmpfiles "${pkgdir}/usr/lib/tmpfiles.d/caddy.conf"
  install -Dm644 caddy.sysusers "${pkgdir}/usr/lib/sysusers.d/caddy.conf"
  install -Dm644 Caddyfile "${pkgdir}/etc/caddy/Caddyfile"
  install -dm755 "${pkgdir}/etc/caddy/conf.d"
  install -Dm644 "${srcdir}/caddy.bash" \
    "${pkgdir}/usr/share/bash-completion/completions/caddy"
  install -Dm644 "${srcdir}/caddy.fish" \
    "${pkgdir}/usr/share/fish/vendor_completions.d/caddy.fish"
  install -Dm644 "${srcdir}/caddy.zsh" \
    "${pkgdir}/usr/share/zsh/site-functions/_caddy"
  install -Dm755 "${srcdir}/caddy" "${pkgdir}/usr/bin/caddy"
  install -Dm644 "caddy-${_caddy_version}/LICENSE" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
