#!/usr/bin/env bash
set -euo pipefail

pkgbuild=${1:-packages/amneziawg-linux-lts/PKGBUILD}
version=${2:?Usage: update-amneziawg PKGBUILD VERSION}

if [[ ! $version =~ ^[0-9]+(\.[0-9]+)+$ ]]; then
  printf 'Unexpected upstream version: %s\n' "$version" >&2
  exit 1
fi

tag=v${version}
archive=$(mktemp)
trap 'rm -f "$archive"' EXIT

curl --fail --silent --show-error --location \
  "https://github.com/amnezia-vpn/amneziawg-linux-kernel-module/archive/refs/tags/${tag}.tar.gz" \
  --output "$archive"
checksum=$(sha256sum "$archive" | awk '{ print $1 }')

sed -i \
  -e "s/^_upstream_version=.*/_upstream_version=${version}/" \
  -e "s/^sha256sums=.*/sha256sums=('${checksum}')/" \
  "$pkgbuild"

printf 'Selected AmneziaWG %s (%s)\n' "$version" "$checksum"
