#!/usr/bin/env bash
set -euo pipefail

package_directory=$1
repository_url=${2:-https://jfk9w.github.io/archery}
temporary_directory=$(mktemp -d)
trap 'rm -rf "${temporary_directory}"' EXIT

mapfile -t metadata < <(bash -c '
  source "$1"
  printf "%s\n%s\n%s\n%s\n" "$pkgname" "$pkgver" "$pkgrel" "${epoch:-}"
' _ "${package_directory}/PKGBUILD")
package_name=${metadata[0]}
package_version=${metadata[1]}
package_release=${metadata[2]}
epoch=${metadata[3]}
expected_version="${package_version}-${package_release}"
if [[ -n ${epoch} ]]; then
  expected_version="${epoch}:${expected_version}"
fi

curl --fail --silent --show-error --location \
  "${repository_url}/x86_64/archery.db.tar.zst" \
  --output "${temporary_directory}/archery.db.tar.zst"
curl --fail --silent --show-error --location \
  "${repository_url}/x86_64/archery.db.tar.zst.sig" \
  --output "${temporary_directory}/archery.db.tar.zst.sig"
curl --fail --silent --show-error --location \
  "${repository_url}/archery.gpg" --output "${temporary_directory}/archery.gpg"

export GNUPGHOME="${temporary_directory}/gnupg"
install -dm700 "${GNUPGHOME}"
gpg --batch --quiet --import "${temporary_directory}/archery.gpg"
gpg --batch --verify "${temporary_directory}/archery.db.tar.zst.sig" \
  "${temporary_directory}/archery.db.tar.zst"

mkdir "${temporary_directory}/database"
bsdtar -xf "${temporary_directory}/archery.db.tar.zst" \
  -C "${temporary_directory}/database"

filename=''
while IFS= read -r description; do
  name=$(awk '/^%NAME%$/ { getline; print; exit }' "${description}")
  version=$(awk '/^%VERSION%$/ { getline; print; exit }' "${description}")
  if [[ ${name} == "${package_name}" && ${version} == "${expected_version}" ]]; then
    filename=$(awk '/^%FILENAME%$/ { getline; print; exit }' "${description}")
    break
  fi
done < <(find "${temporary_directory}/database" -name desc -type f -print)

if [[ -z ${filename} ]]; then
  printf 'No published %s %s found\n' "${package_name}" "${expected_version}"
  exit 1
fi

curl --fail --silent --show-error --location \
  "${repository_url}/x86_64/${filename}" --output "${package_directory}/${filename}"
curl --fail --silent --show-error --location \
  "${repository_url}/x86_64/${filename}.sig" \
  --output "${temporary_directory}/${filename}.sig"
gpg --batch --verify "${temporary_directory}/${filename}.sig" \
  "${package_directory}/${filename}"

printf 'Reusing published %s %s (%s)\n' \
  "${package_name}" "${expected_version}" "${filename}"
