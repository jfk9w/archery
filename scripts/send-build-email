#!/usr/bin/env bash
set -euo pipefail

required=(SMTP_URL SMTP_USERNAME SMTP_PASSWORD SMTP_FROM SMTP_TO)
for variable in "${required[@]}"; do
  if [[ -z ${!variable:-} ]]; then
    printf 'Email notification disabled: %s is not configured\n' "${variable}"
    exit 0
  fi
done

message=$(mktemp)
trap 'rm -f "${message}"' EXIT

{
  printf 'From: %s\r\n' "${SMTP_FROM}"
  printf 'To: %s\r\n' "${SMTP_TO}"
  printf 'Subject: archery packages published\r\n'
  printf 'Date: %s\r\n' "$(date --rfc-email)"
  printf '\r\nNew package builds were published:\r\n\r\n'
  while read -r package rebuilt; do
    if [[ ${rebuilt} == true ]]; then
      printf '%s\r\n' "${package%:}"
    fi
  done <<<"${ARCHERY_BUILT_PACKAGES}"
  printf '\r\n%s\r\n' "${ARCHERY_RUN_URL}"
} >"${message}"

curl --fail --silent --show-error --ssl-reqd \
  --url "${SMTP_URL}" \
  --user "${SMTP_USERNAME}:${SMTP_PASSWORD}" \
  --mail-from "${SMTP_FROM}" \
  --mail-rcpt "${SMTP_TO}" \
  --upload-file "${message}"
